# ==============================================================================
# Batack API - Exemple de configuration (NE PAS METTRE DE VRAIS SECRETS ICI)
# Copier vers .env et remplacer toutes les valeurs CHANGE_ME_* avant lancement.
# ==============================================================================

# --- Application ---
APP_NAME=Batack API
TOTP_ISSUER_NAME=Batack
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_SITE_URL=https://votre-domaine.org
BACKEND_PUBLIC_URL=https://api.votre-domaine.org
API_PORT=8001
CORS_ORIGINS=https://votre-domaine.org

# --- Coordonnées & comptes du COVIDEBA ---
# Configurables directement depuis l'interface d'administration (Paramètres & comptes).

# --- Proxy & Limitation de requêtes ---
# N'activer TRUST_PROXY_HEADERS=true que derrière un reverse proxy de confiance (Nginx, Caddy, Traefik)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=127.0.0.1,::1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Base de données PostgreSQL ---
POSTGRES_USER=batack
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=batack
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://batack:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5435/batack

# --- Base de données de test ---
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_batack.db

# --- Redis (obligatoirement protégé par mot de passe) ---
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379/0

# --- Sécurité, JWT & Sessions ---
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_48_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=cb3_session
SESSION_IDLE_HOURS=8
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- Stockage local & Ressources externes optionnelles ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=10485760
FRONTEND_IMAGES_DIR=
FRONTEND_I18N_DIR=

# --- Envoi d'e-mails (SMTP pour double opt-in suivi de projet) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@batack.org
SMTP_USE_TLS=true

# --- Traduction automatique des projets (Google Translate) ---
# Clé API Google Cloud Translation v2 (optionnelle : si vide, utilise le endpoint public Google Translate)
GOOGLE_TRANSLATE_API_KEY=

# --- Initialisation / Seed ---
SEED_ON_STARTUP=false
ADMIN_DEFAULT_EMAIL=admin@batack.org
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=Administrateur ENSPY
