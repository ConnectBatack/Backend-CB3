# ==============================================================================
# ConnectBatack 3 - Configuration Backend (FastAPI)
# Copier ce fichier vers .env et adapter les secrets avant le déploiement.
# ==============================================================================

# --- Application ---
APP_NAME=ConnectBatack 3 API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PUBLIC_SITE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Base de données PostgreSQL ---
POSTGRES_USER=batack
POSTGRES_PASSWORD=batack_dev_password_change_me
POSTGRES_DB=connectbatack3
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://batack:batack_dev_password_change_me@localhost:5432/connectbatack3

# --- Base de données de test ---
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_batack.db

# --- Redis (optionnel, limitation de requêtes distribuée) ---
REDIS_URL=redis://localhost:6379/0

# --- Sécurité, JWT & Sessions ---
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev_insecure_change_me_use_at_least_32_characters_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=cb3_session
SESSION_IDLE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Limitation de tentatives de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Stockage local des médias (photos, justificatifs, documents) ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Stripe (mode test obligatoire sauf PAIEMENT_REEL_AUTORISE=oui) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAIEMENT_REEL_AUTORISE=non
DON_MENSUEL_ACTIF=false
DON_MONTANT_MIN_EUR=5
DON_MONTANT_MAX_EUR=5000

# --- Initialisation / Seed ---
SEED_ON_STARTUP=true
ADMIN_DEFAULT_EMAIL=admin@batack.org
ADMIN_DEFAULT_PASSWORD=BatackAdmin2026!
ADMIN_DEFAULT_NAME=Administrateur ENSPY

