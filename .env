# ==============================================================================
# ConnectBatack 3 - Configuration locale de développement
# Ne jamais commiter de vrais secrets de production dans git.
# ==============================================================================

APP_NAME=ConnectBatack 3 API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PUBLIC_SITE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8001
API_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_USER=batack
POSTGRES_PASSWORD=batack_dev_password_change_me
POSTGRES_DB=connectbatack3
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://batack:batack_dev_password_change_me@localhost:5435/connectbatack3

TEST_DATABASE_URL=sqlite+aiosqlite:///./test_batack.db

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=batack_dev_secret_key_change_in_production_min_48_chars_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=cb3_session
SESSION_IDLE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAIEMENT_REEL_AUTORISE=non
DON_MENSUEL_ACTIF=false
DON_MONTANT_MIN_EUR=5
DON_MONTANT_MAX_EUR=5000

SEED_ON_STARTUP=true
ADMIN_DEFAULT_EMAIL=admin@batack.org
ADMIN_DEFAULT_PASSWORD=BatackAdmin2026!
ADMIN_DEFAULT_NAME=Administrateur ENSPY

